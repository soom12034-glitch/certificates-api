<UserControl x:Class="BlueMax.Presentation.Wpf.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="رجوع" />
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" /> <!-- Input Section (Sidebar) -->
                <ColumnDefinition Width="*" />   <!-- Table Section (Main Content) -->
            </Grid.ColumnDefinitions>

            <!-- Input Section -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Form -->
                        <RowDefinition Height="Auto" /> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="إضافة / تعديل قطعة غيار" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="كود القطعة (SKU)" Foreground="White" Margin="0,5" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />

                            <TextBlock Text="اسم القطعة" Foreground="White" Margin="0,10,0,5" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الكمية المتوفرة" Foreground="White" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="حد النواقص" Foreground="White" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding MinThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="تاريخ الشراء" Foreground="White" Margin="0,10,0,5" />
                            <DatePicker SelectedDate="{Binding PurchaseDate}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="سعر التكلفة" Foreground="White" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="سعر البيع" Foreground="White" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="العلامة التجارية (البراند)" Foreground="White" Margin="0,10,0,5" />
                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />

                            <TextBlock Text="موقع التخزين (الرف)" Foreground="White" Margin="0,10,0,5" />
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="تفريغ" Width="70" Margin="5" Command="{Binding NewItemCommand}" Style="{StaticResource ModernButtonStyle}" />
                        <Button Content="حفظ" Width="70" Margin="5" Command="{Binding SaveItemCommand}" Style="{StaticResource ModernButtonStyle}" />
                        <Button Content="حذف" Width="70" Margin="5" Command="{Binding DeleteItemCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF5252" BorderBrush="#FF5252" />
                        <Button Content="باركود" Width="70" Margin="5" Command="{Binding PrintBarcodeCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF9800" BorderBrush="#FF9800" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Table Section -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Low Stock Alert Banner -->
                    <Border Grid.Row="0" Background="#FFFDE7E9" BorderBrush="#FFD32F2F" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLowStockAlert}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="#FFD32F2F" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="⚠️ تحذير: يوجد عدد (" />
                                <Run Text="{Binding LowStockCount}" />
                                <Run Text=") قطع وصلت لحد النواقص ويرجى طلبها فوراً!" />
                            </TextBlock>
                            <CheckBox Grid.Column="1" Content="عرض النواقص فقط" IsChecked="{Binding ShowLowStockOnly}" Foreground="#FFD32F2F" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="مخزون قطع الغيار" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        
                        <TextBox Grid.Column="1" Margin="10,0" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 ToolTip="البحث بالكود، الاسم، أو البراند" />
                        
                        <Button Grid.Column="2" Content="بحث / تحديث" Command="{Binding RefreshItemsCommand}" Style="{StaticResource ModernButtonStyle}" Width="100" Margin="0,0,10,0" />
                        <Button Grid.Column="3" Content="طباعة تقرير" Command="{Binding PrintReportCommand}" Style="{StaticResource ModernButtonStyle}" Width="100" />
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              BorderThickness="1"
                              BorderBrush="#EEEEEE">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Highlight row in red if stock is low -->
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FFFDE7E9" />
                                        <Setter Property="Foreground" Value="#FFD32F2F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود القطعة" Binding="{Binding Code}" Width="100" />
                            <DataGridTextColumn Header="اسم القطعة" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70" />
                            <DataGridTextColumn Header="سعر التكلفة" Binding="{Binding CostPrice}" Width="90" />
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellingPrice}" Width="90" />
                            <DataGridTextColumn Header="البراند" Binding="{Binding Brand}" Width="100" />
                            <DataGridTextColumn Header="مكان التخزين" Binding="{Binding Location}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
