<UserControl x:Class="BlueMax.Presentation.Wpf.Views.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCertificateCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintA4Command}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Calibration Certificates"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Grid.Column="1"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="رجوع" />
            </Button>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Certificates">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Section (Sidebar) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="بيانات الشهادة" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="اسم العميل" Foreground="White" Margin="0,0,0,5" />
                                    <Grid>
                                        <TextBox x:Name="ClientNameBox" 
                                                 Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" 
                                                 PreviewKeyDown="ClientNameBox_PreviewKeyDown" />
                                        <Popup x:Name="ClientNamePopup"
                                               IsOpen="{Binding IsClientOptionsOpen}" 
                                               PlacementTarget="{Binding ElementName=ClientNameBox}" 
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Slide">
                                            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" MaxHeight="200" MinWidth="200">
                                                <ListBox x:Name="ClientNameList"
                                                         ItemsSource="{Binding ClientOptions}" 
                                                         SelectedItem="{Binding SelectedClientOption}" 
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                                         BorderThickness="0"
                                                         PreviewKeyDown="ClientNameList_PreviewKeyDown" />
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <TextBlock Text="الهاتف" Foreground="White" Margin="0,10,0,5" />
                                     <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="نوع الجهاز" Foreground="White" Margin="0,10,0,5" />
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" />

                                    <TextBlock Text="الماركة" Foreground="White" Margin="0,10,0,5" />
                                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand}" IsEditable="True" />

                                    <TextBlock Text="الموديل" Foreground="White" Margin="0,10,0,5" />
                                     <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Margin="0,10,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGpsDeviceType}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="السيريال" Foreground="White" Margin="0,0,0,5" />
                                         <TextBox Text="{Binding SerialText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsGpsDeviceType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="GPS Serial 1" Foreground="White" Margin="0,0,0,5" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding GpsSerialKinds}"
                                                      SelectedItem="{Binding SelectedGpsSerial1Kind}" />
                                            <TextBox Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                      Text="{Binding GpsSerial1Text, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsGpsDeviceType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="GPS Serial 2" Foreground="White" Margin="0,0,0,5" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding GpsSerialKinds}"
                                                      SelectedItem="{Binding SelectedGpsSerial2Kind}" />
                                            <TextBox Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                      Text="{Binding GpsSerial2Text, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsTotalStationDeviceType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="الدقة (Total Station)" Foreground="White" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding AccuracyOptions}"
                                                  SelectedItem="{Binding Accuracy}"
                                                  IsEditable="True" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsAutoLevelDeviceType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="معيار الانحراف (Auto Level)" Foreground="White" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding AutoLevelSpecOptions}"
                                                  Text="{Binding SpecValue, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" />
                                    </StackPanel>

                                    <TextBlock Text="اسم المندوب" Foreground="White" Margin="0,10,0,5" />
                                     <TextBox Text="{Binding DelegateName, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="تاريخ الإصدار" Foreground="White" Margin="0,0,0,5" />
                                            <DatePicker SelectedDate="{Binding IssueDate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="تاريخ الانتهاء" Foreground="White" Margin="0,0,0,5" />
                                            <DatePicker SelectedDate="{Binding ExpiryDate}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="رقم الشهادة" Foreground="White" Margin="0,10,0,5" />
                                     <TextBox Text="{Binding CertificateNumber}" IsReadOnly="True" />

                                    <TextBlock Text="{Binding ModeText}"
                                               Margin="0,10,0,0"
                                               Foreground="#E0E0E0" />
                                    
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#E0E0E0" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button Content="جديد" Width="70" Margin="2" Command="{Binding NewCertificateCommand}" />
                                    <Button Content="حفظ" Width="70" Margin="2" Command="{Binding SaveCertificateCommand}" />
                                    <Button Content="تعديل" Width="70" Margin="2" Command="{Binding EditOldCertificateCommand}" />
                                    <Button Content="حذف" Width="70" Margin="2" Command="{Binding DeleteCertificateCommand}" Background="#FF5252" BorderBrush="#FF5252" />
                                </StackPanel>
                                <Separator Background="#30FFFFFF" Margin="0,5,0,5" />
                                <TextBlock Text="طباعة / تصدير" Foreground="White" FontWeight="SemiBold" Margin="0,5" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="ملصق" Width="80" Margin="2" Command="{Binding PrintStickerCommand}" />
                                    <Button Content="معاينة" Width="80" Margin="2" Command="{Binding PreviewStickerZplCommand}" />
                                    <Button Content="A4" Width="80" Margin="2" Command="{Binding PrintA4Command}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Section (Main Content) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الأرشيف" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                
                                <TextBox Grid.Column="1" Margin="10,0" 
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                          KeyDown="ArchiveSearchBox_KeyDown" />
                                
                                <Button Grid.Column="2" Content="تحديث" Command="{Binding RefreshCertificatesCommand}" Width="100" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Certificates}"
                                      SelectedItem="{Binding SelectedCertificate}"
                                      MouseDoubleClick="ArchiveGrid_MouseDoubleClick"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      BorderThickness="1"
                                      BorderBrush="#EEEEEE">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم" Binding="{Binding CertificateNumber}" Width="*" />
                                    <DataGridTextColumn Header="العميل" Binding="{Binding ClientName}" Width="*" />
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="*" />
                                    <DataGridTextColumn Header="النوع" Binding="{Binding DeviceType}" Width="*" />
                                    <DataGridTextColumn Header="الموديل" Binding="{Binding Model}" Width="*" />
                                    <DataGridTextColumn Header="السيريال" Binding="{Binding SerialText}" Width="*" />
                                    <DataGridTextColumn Header="الانتهاء" Binding="{Binding ExpiryDate, StringFormat=dd-MM-yyyy}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Background="#66000000"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                          Panel.ZIndex="100" Grid.ColumnSpan="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="260" />
                            <TextBlock Text="{Binding BusyMessage}" Foreground="White" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="إدارة القوالب">
                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <GroupBox Header="1) اختيار نوع المستند">
                                <StackPanel Margin="10">
                                    <TextBlock Text="نوع المستند" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding TemplateHubDocumentTypes}"
                                              SelectedItem="{Binding SelectedTemplateHubDocumentType}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="المسار الحالي" Margin="0,10,0,6" />
                                    <TextBox Text="{Binding SelectedTemplateHubPath}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2) اختيار وحفظ القالب" Margin="0,12,0,0">
                                <StackPanel Margin="10">
                                    <Button Content="اختيار ملف Word (.docx)"
                                            Command="{Binding UploadWordTemplateHubCommand}" />
                                    <Button Content="حفظ الإعداد"
                                            Margin="0,8,0,0"
                                            Command="{Binding SaveTemplateHubConfigurationCommand}" />
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <Expander Grid.Column="1" Header="قاموس الوسوم (اختياري)" IsExpanded="False">
                            <DataGrid Margin="10"
                                      ItemsSource="{Binding TemplateHubTags}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*" />
                                    <DataGridTextColumn Header="الوسم" Binding="{Binding Tag}" Width="2*" />
                                    <DataGridTemplateColumn Header="" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="نسخ"
                                                        Style="{StaticResource CapsuleButtonStyle}"
                                                        Command="{Binding DataContext.CopyTemplateHubTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Tag}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
