<UserControl x:Class="BlueMax.Presentation.Wpf.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="إدارة الصيانة"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Grid.Column="1"
                    Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="رجوع" />
            </Button>
        </Grid>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="أوامر الصيانة">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Section (Sidebar) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="أمر صيانة" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="اسم العميل" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />

                                    <TextBlock Text="الهاتف" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />

                                    <TextBlock Text="نوع الجهاز" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" IsEnabled="{Binding IsInputsEditable}" FontSize="13" Height="30" Padding="5,5" />

                                    <TextBlock Text="الماركة" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand}" IsEditable="True" IsEnabled="{Binding IsInputsEditable}" FontSize="13" Height="30" Padding="5,5" />

                                    <TextBlock Text="الموديل" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="الرقم التسلسلي 1" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="الرقم التسلسلي 2 (اختياري)" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                            <TextBox Text="{Binding SerialNumber2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" IsEnabled="{Binding IsGpsDevice}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="الملحقات" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <TextBox Text="{Binding Accessories, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />

                                    <TextBlock Text="الشكوى" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <TextBox Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Top" FontSize="13" Padding="5,5" />

                                    <TextBlock Text="التقرير الفني" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <TextBox Text="{Binding TechnicalReport, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Top" FontSize="13" Padding="5,5" />

                                    <TextBlock Text="الحالة" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" FontSize="13" Height="30" Padding="5,5" />

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="تكلفة القطع" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                            <TextBox Text="{Binding PartsCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="تكلفة العمل" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                            <TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Style="{StaticResource ModernTextBox}" FontSize="13" Height="30" Padding="5,5" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="الإجمالي" Foreground="White" Margin="0,5,0,1" FontSize="12" />
                                    <TextBox Text="{Binding TotalCost, Mode=OneWay}" Style="{StaticResource ModernTextBox}" IsReadOnly="True" FontSize="13" Height="30" Padding="5,5" />

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="تاريخ الاستلام" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                            <DatePicker SelectedDate="{Binding ReceivedDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="13" Height="30" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="تاريخ التحديث" Foreground="White" Margin="0,0,0,1" FontSize="12" />
                                            <DatePicker SelectedDate="{Binding UpdatedDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="13" Height="30" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button Content="جديد" Width="55" Margin="2" Command="{Binding NewWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="تعديل" Width="55" Margin="2" Command="{Binding EditWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="حفظ" Width="55" Margin="2" Command="{Binding SaveWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="➕ جهاز إضافي للعميل" Width="130" Margin="2" Command="{Binding AddDeviceToSameReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF4CAF50" ToolTip="نسخ بيانات العميل ورقم الإيصال لسهولة إضافة جهاز جديد" />
                                    <Button Content="حذف" Width="55" Margin="2" Command="{Binding DeleteWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF5252" Foreground="White" />
                                </StackPanel>
                                <Separator Background="#30FFFFFF" Margin="0,5,0,5" />
                                <TextBlock Text="إجراءات" Foreground="White" FontWeight="SemiBold" Margin="0,5" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="عرض سعر" Width="80" Margin="2" Command="{Binding GenerateQuotationCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="عرض سعر صيانة" />
                                    <Button Content="إيصال فردى" Width="80" Margin="2" Command="{Binding GenerateInvoiceCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="تقرير" Width="80" Margin="2" Command="{Binding GenerateMaintenanceReportCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="تقرير صيانة" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="معاينة" Width="80" Margin="2" Command="{Binding PreviewWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="معاينة بيانات الجهاز والتقرير الفني" />
                                    <Button Content="إيصال استلام" Width="110" Margin="2" Command="{Binding PrintReceiptCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="طباعة إيصال استلام الجهاز" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Section (Main Content) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="طلبات الصيانة" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <TextBox Grid.Column="1" Margin="10,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" />

                                <Button Grid.Column="2" Content="تحديث" Command="{Binding RefreshWorkOrdersCommand}" Style="{StaticResource ModernButtonStyle}" Width="100" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding WorkOrders}"
                                      SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      MouseDoubleClick="OnWorkOrdersDoubleClick"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      BorderThickness="1"
                                      BorderBrush="#EEEEEE">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding ReceiptGroupNumber}" Width="90" />
                                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="1.5*" />
                                    <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceType}" Width="*" />
                                    <DataGridTextColumn Header="الموديل" Binding="{Binding Model}" Width="*" />
                                    <DataGridTextColumn Header="السيريال" Binding="{Binding SerialNumber}" Width="*" />
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="الاستلام" Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="استيكر الاستلام">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="طباعة استيكر استلام الصيانة" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="هذه الشاشة مستقلة تمامًا عن استيكر شهادات المعايرة." FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Text="المقاس: عرض 41 مم × ارتفاع 21 مم" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="نافذة إعدادات وطباعة استيكر الاستلام"
                                    Width="280"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Command="{Binding OpenReceiptStickerSettingsCommand}"
                                    Style="{StaticResource ModernButtonStyle}" />
                            <Button Content="طباعة الآن"
                                    Width="140"
                                    Height="36"
                                    Command="{Binding PrintReceiptStickerCommand}"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </StackPanel>

                        <TextBlock Text="ملاحظة: يمكن اختيار طابعة منفصلة وضبط الإعدادات من النافذة (تكبير/إزاحة)، ولن يؤثر ذلك على أي إعدادات لطابعة استيكر الشهادات." TextWrapping="Wrap" FontSize="13" Foreground="#374151" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
