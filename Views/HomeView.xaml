<UserControl x:Class="BlueMax.Presentation.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBackground}"
             FlowDirection="RightToLeft">
    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource HeaderBackground}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0" />
                            <GradientStop Color="#06B6D4" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="CC" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="نظام إدارة المعايرة"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Width="48"
                        Height="48"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border>
                        <TextBlock Text="⚙" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style x:Key="GlassyButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="200"/>
                        <Setter Property="Height" Value="90"/>
                        <Setter Property="Margin" Value="12"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="RootBorder" CornerRadius="18" Background="#FFFFFF">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#55000000" BlurRadius="18" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="30" CornerRadius="18,18,10,10" Opacity="0.5">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                        <GradientStop Color="#80FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Style="{StaticResource GlassyButtonStyle}"
                            Command="{Binding DataContext.ShowCertificatesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="24" Foreground="#283593" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Certificates" FontSize="15" FontWeight="SemiBold" Foreground="#283593" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassyButtonStyle}"
                            Command="{Binding DataContext.ShowMaintenanceCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔧" FontSize="24" Foreground="#EF6C00" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="الصيانة" FontSize="15" FontWeight="SemiBold" Foreground="#EF6C00" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassyButtonStyle}"
                            Command="{Binding DataContext.ShowClientsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="24" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="قاعدة بيانات العملاء" FontSize="15" FontWeight="SemiBold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlassyButtonStyle}"
                            Command="{Binding DataContext.ShowInventoryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="24" Foreground="#6A1B9A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="المخزون" FontSize="15" FontWeight="SemiBold" Foreground="#6A1B9A" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
            <!-- الشريط السفلي أزيل بالكامل حسب المتطلبات -->
        </Grid>
    </Grid>
</UserControl>
