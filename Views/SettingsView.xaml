<UserControl x:Class="BlueMax.Presentation.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
            <Button Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="رجوع" />
            </Button>
        </StackPanel>
        
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Tab 1: General & Reports -->
            <TabItem Header="عام وتقارير">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="إعدادات التقرير">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="طباعة الخلفية" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding PrintWithBackground}" />
                                <TextBlock Grid.Row="1" Text="هامش علوي (مم)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding MarginTopMm}" />
                                <TextBlock Grid.Row="2" Text="هامش سفلي (مم)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding MarginBottomMm}" />
                                <TextBlock Grid.Row="3" Text="هامش أيمن (مم)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding MarginRightMm}" />
                                <TextBlock Grid.Row="4" Text="هامش أيسر (مم)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding MarginLeftMm}" />
                                <TextBlock Grid.Row="5" Text="اختصار الشركة" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding CompanyHeader}" />
                                <TextBlock Grid.Row="6" Text="اسم الشركة" VerticalAlignment="Center" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding CompanyName}" />
                                <TextBlock Grid.Row="7" Text="العنوان" VerticalAlignment="Center" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding CompanyAddress}" />
                                <TextBlock Grid.Row="8" Text="هاتف الشركة" VerticalAlignment="Center" />
                                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding CompanyPhone}" />
                                <TextBlock Grid.Row="9" Text="أيقونة البرنامج" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="300" Style="{StaticResource ModernTextBox}" Text="{Binding AppIconPath}" />
                                    <Button Content="رفع أيقونة" Width="120" Margin="8,0,0,0" Command="{Binding UploadAppIconCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Row="10" Text="مسار LibreOffice" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="300" Style="{StaticResource ModernTextBox}" Text="{Binding LibreOfficeProgramPath}" />
                                    <Button Content="تحديد" Width="120" Margin="8,0,0,0" Command="{Binding ChooseLibreOfficeProgramCommand}" />
                                </StackPanel>
                                <StackPanel Grid.Row="11" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="رفع رأس" Width="110" Margin="0,0,8,0" Command="{Binding UploadHeaderCommand}" />
                                    <Button Content="رفع تذييل" Width="110" Margin="0,0,8,0" Command="{Binding UploadFooterCommand}" />
                                    <Button Content="حفظ إعدادات التقرير" Width="160" Command="{Binding SaveReportCommand}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="التحقق عبر الويب" Margin="0,12,0,0">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="رابط الأساس" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding VerificationBaseUrl}" />
                                <Button Grid.Column="2" Content="حفظ" Width="90" Command="{Binding SaveVerificationCommand}" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="قاعدة البيانات (SQL Server)" Margin="0,12,0,0">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الموفر الحالي" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentDatabaseProvider}" VerticalAlignment="Center" Foreground="SteelBlue" />
                                <TextBlock Grid.Row="1" Text="سلسلة الاتصال" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding DbConnectionStringInput}" />
                                <Button Grid.Row="2" Grid.ColumnSpan="3" Content="حفظ إعداد قاعدة البيانات" Width="220" HorizontalAlignment="Right" Command="{Binding SaveDbConnectionCommand}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Tab 2: Printers -->
            <TabItem Header="الطابعات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="إعدادات طابعة A4">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="اسم الطابعة" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox Width="260" ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding SelectedA4PrinterName}" />
                                    <Button Content="خصائص" Width="90" Margin="8,0,0,0" Command="{Binding OpenA4PrinterPropertiesCommand}" />
                                    <Button Content="تفضيلات" Width="90" Margin="8,0,0,0" Command="{Binding OpenA4PrinterPreferencesCommand}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="إعدادات طابعة الملصق">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="موديل/بروتوكول الطابعة" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PrinterProtocolOptions}"
                                          SelectedItem="{Binding SelectedPrinterProtocolItem}"
                                          DisplayMemberPath="Label" />
                                <TextBlock Grid.Row="1" Text="نوع الاتصال" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding ConnectionType}" />
                                <TextBlock Grid.Row="2" Text="اسم الطابعة" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox Width="260" ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding SelectedPrinterName}" />
                                    <Button Content="خصائص" Width="90" Margin="8,0,0,0" Command="{Binding OpenPrinterPropertiesCommand}" />
                                    <Button Content="تفضيلات" Width="90" Margin="8,0,0,0" Command="{Binding OpenPrinterPreferencesCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="المضيف" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding NetworkHost}" />
                                <TextBlock Grid.Row="4" Text="المنفذ" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding NetworkPort}" />
                                <TextBlock Grid.Row="5" Text="عرض الملصق (مم)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding LabelWidthMm}" />
                                <TextBlock Grid.Row="6" Text="ارتفاع الملصق (مم)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding LabelHeightMm}" />
                                <TextBlock Grid.Row="7" Text="الحدة" VerticalAlignment="Center" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding Darkness}" />
                                <TextBlock Grid.Row="8" Text="السرعة (IPS)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding SpeedIps}" />
                                <TextBlock Grid.Row="9" Text="نقاط/مم" VerticalAlignment="Center" />
                                <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding DotsPerMm}" />
                                <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="حفظ إعدادات الطابعة" Width="180" Command="{Binding SavePrinterCommand}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="إعدادات TSPL" Margin="0,12,0,0">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPrinterProtocolItem.Code}" Value="TSPL">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Media Type" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TsplMediaOptions}"
                                          SelectedItem="{Binding SelectedTsplMediaItem}"
                                          DisplayMemberPath="Label" />
                                <TextBlock Grid.Row="1" Text="Gap (mm)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding TsplGapMm}" />
                                <TextBlock Grid.Row="2" Text="Gap Offset (mm)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding TsplGapOffsetMm}" />
                                <TextBlock Grid.Row="3" Text="Black Mark Offset (mm)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding TsplBlackMarkOffsetMm}" />
                                <TextBlock Grid.Row="4" Text="Direction" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="4" Grid.Column="1" SelectedValue="{Binding TsplDirection}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Normal (0)" Tag="0" />
                                    <ComboBoxItem Content="Reverse (1)" Tag="1" />
                                </ComboBox>
                                <TextBlock Grid.Row="5" Text="Copies" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding TsplCopies}" />
                                <TextBlock Grid.Row="6" Text="Reference X" VerticalAlignment="Center" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding TsplReferenceX}" />
                                <TextBlock Grid.Row="7" Text="Reference Y" VerticalAlignment="Center" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding TsplReferenceY}" />
                                <CheckBox Grid.Row="8" Content="معايرة تلقائية عند الطباعة" IsChecked="{Binding TsplCalibrateOnPrint}" />
                                <TextBlock Grid.Row="9" Text="Codepage" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="9" Grid.Column="1"
                                          ItemsSource="{Binding TsplCodepageOptions}"
                                          SelectedItem="{Binding SelectedTsplCodepageItem}"
                                          DisplayMemberPath="Label" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="صلاحيات الدخول">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="الوضع الحالي">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الدخول كـ" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SessionRoleDisplay}" Foreground="SteelBlue" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="تسجيل دخول المدير" Width="160" Margin="0,0,8,0" Command="{Binding LoginAsAdminCommand}" />
                                    <Button Content="تسجيل خروج المدير" Width="150" Margin="0,0,8,0" Command="{Binding LogoutAdminCommand}" />
                                    <Button Content="تسجيل خروج المستخدم" Width="170" Command="{Binding LogoutUserCommand}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="تسجيل دخول المستخدم" Margin="0,12,0,0">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <StackPanel Margin="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="اسم المستخدم" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding LoginUsernames}" SelectedItem="{Binding SelectedLoginUsername}" />
                                    <TextBlock Grid.Row="1" Text="كلمة المرور" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <PasswordBox Grid.Row="1" Grid.Column="1" Width="260" Margin="0,10,0,0" PasswordChanged="OnLoginPasswordChanged" />
                                    <Button Grid.Row="2" Grid.ColumnSpan="3" Content="تسجيل الدخول" Width="160" HorizontalAlignment="Right" Margin="0,12,0,0" Command="{Binding LoginUserCommand}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="إدارة المستخدمين" Margin="0,12,0,0">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <StackPanel Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="المستخدم" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="260"
                                              ItemsSource="{Binding AdminUsers}"
                                              SelectedItem="{Binding SelectedAdminUser}"
                                              DisplayMemberPath="Username" />
                                    <Button Grid.Column="2" Content="إضافة" Width="90" Margin="8,0,0,0" Command="{Binding AddUserCommand}" />
                                    <Button Grid.Column="3" Content="حذف" Width="90" Margin="8,0,0,0" Command="{Binding DeleteUserCommand}" />
                                    <Button Grid.Column="4" Content="تغيير كلمة المرور" Width="150" Margin="8,0,0,0" Command="{Binding ChangeUserPasswordCommand}" />
                                </Grid>

                                <Border BorderBrush="#20000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding SelectedUserPermissions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Title}"
                                                          IsChecked="{Binding IsAllowed}"
                                                          Margin="0,0,16,10"
                                                          FontSize="14" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="حفظ الصلاحيات" Width="140" Command="{Binding SaveUserPermissionsCommand}" />
                                </StackPanel>
                                <TextBlock Text="صلاحيات الإدارة لا تظهر للمستخدم العادي ويتم تطبيق المنع على كل التنقلات." Foreground="#666" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="الرقم السري للمدير" Margin="0,12,0,0">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="الرقم السري الافتراضي: 0000 (يمكن تغييره لاحقًا)." TextWrapping="Wrap" />
                                <Button Grid.Row="1" Content="تغيير الرقم السري" Width="160" HorizontalAlignment="Right" Margin="0,10,0,0"
                                        Command="{Binding ChangeAdminPinCommand}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: License -->
            <TabItem Header="الترخيص">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <GroupBox Header="معلومات الترخيص">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="حالة الترخيص:" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LicenseStatusDisplay}" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="تاريخ الانتهاء:" FontWeight="Bold" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseExpirationDate}" Margin="0,10,0,0" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="بصمة الجهاز:" FontWeight="Bold" Margin="0,10,0,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBox Text="{Binding LicenseHardwareId}" IsReadOnly="True" Width="250" Style="{StaticResource ModernTextBox}" Background="#EEE"/>
                                        <Button Content="نسخ" Command="{Binding CopyHardwareIdCommand}" Width="80" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="تحديث الترخيص" Margin="0,20,0,0">
                                <StackPanel Margin="10">
                                    <TextBlock Text="إذا كان لديك مفتاح تفعيل جديد، أدخله هنا:" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding LicenseKeyInput}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource ModernTextBox}"/>
                                    <Button Content="تفعيل الترخيص" Command="{Binding ActivateLicenseCommand}" HorizontalAlignment="Right" Width="150" Margin="0,10,0,0" Height="35"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Image on the Left (Column 1 in RTL) -->
                    <Image Grid.Column="1" Source="pack://application:,,,/BlueMax.Presentation.Wpf;component/Assets/Images/Calibration3.png" Stretch="Uniform" Margin="20" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
        
        <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="0,8,0,0"
                   Foreground="Lime"
                   FontWeight="Bold" />
    </Grid>
</UserControl>
