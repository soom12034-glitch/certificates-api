<UserControl x:Class="BlueMax.Presentation.Wpf.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="رجوع" />
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" /> <!-- Input Section (Sidebar) -->
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.5*" />  <!-- History Section (Middle) -->
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />  <!-- Clients List (Right/End) -->
            </Grid.ColumnDefinitions>

            <!-- Input Section -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Form -->
                        <RowDefinition Height="Auto" /> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="بيانات العميل" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="الاسم" Foreground="White" Margin="0,5" />
                            <TextBox Text="{Binding CustomerNameInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />

                            <TextBlock Text="الهاتف" Foreground="White" Margin="0,10,0,5" />
                            <TextBox Text="{Binding CustomerPhoneInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />

                            <TextBlock Text="العنوان" Foreground="White" Margin="0,10,0,5" />
                            <TextBox Text="{Binding CustomerAddressInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />

                            <TextBlock Text="ملاحظات" Foreground="White" Margin="0,10,0,5" />
                            <TextBox Text="{Binding CustomerNotesInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="80" AcceptsReturn="True" TextWrapping="Wrap" 
                                     Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="تفريغ" Width="60" Margin="5" Command="{Binding NewCustomerCommand}" Style="{StaticResource ModernButtonStyle}" />
                        <Button Content="حفظ" Width="60" Margin="5" Command="{Binding SaveCustomerCommand}" Style="{StaticResource ModernButtonStyle}" />
                        <Button Content="حذف" Width="60" Margin="5" Command="{Binding DeleteCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF5252" BorderBrush="#FF5252" />
                        <Button Content="تقرير" Width="60" Margin="5" Command="{Binding PrintReportCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF9800" BorderBrush="#FF9800" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- History Section (Middle) -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="سجل الأجهزة والصيانة" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333" />
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WorkOrders}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15"
                              BorderThickness="1" BorderBrush="#EEEEEE"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" Width="90" />
                            <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceType}" Width="100" />
                            <DataGridTextColumn Header="الموديل" Binding="{Binding Model}" Width="80" />
                            <DataGridTextColumn Header="التكلفة" Binding="{Binding TotalCost}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Calibration Certificates" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333" />
                    
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Certificates}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="1" BorderBrush="#EEEEEE"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الشهادة" Binding="{Binding CertificateNumber}" Width="100" />
                            <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceType}" Width="100" />
                            <DataGridTextColumn Header="الإصدار" Binding="{Binding IssueDate, StringFormat=yyyy-MM-dd}" Width="90" />
                            <DataGridTextColumn Header="الانتهاء" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Table Section (Right/End) -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,10,0" 
                                 Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 ToolTip="بحث ذكي بالاسم أو الهاتف" />
                        
                        <Button Grid.Column="1" Content="بحث" Command="{Binding RefreshCustomersCommand}" Style="{StaticResource ModernButtonStyle}" Width="60" Margin="0,0,5,0" />
                        <Button Grid.Column="2" Content="تحديث" Command="{Binding RefreshCustomersCommand}" Style="{StaticResource ModernButtonStyle}" Width="60" Background="#4CAF50" BorderBrush="#4CAF50" ToolTip="تحديث قائمة العملاء" />
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              BorderThickness="1"
                              BorderBrush="#EEEEEE">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="⚠️" Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="🚨" Visibility="{Binding HasCalibrationAlert, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" ToolTip="تنبيه: يوجد أجهزة انتهت أو شارفت معايرتها على الانتهاء"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="اسم الشركة / العميل" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
