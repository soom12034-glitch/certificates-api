<Window x:Class="BlueMax.Presentation.Wpf.Views.ClientReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="كشف حساب عميل"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="الطابعة" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding SelectedPrinterName}" Height="30" />
                <Button Grid.Column="2" Content="تحديد الطابعة" Width="100" Height="32" Margin="10,0,0,0" Command="{Binding ChoosePrinterCommand}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="تحديث المعاينة" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding RefreshPreviewCommand}" />
                    <Button Content="طباعة" Width="90" Height="32" Margin="0,0,8,0" Command="{Binding PrintCommand}" />
                </StackPanel>
                <Button Grid.Column="4" Content="إغلاق" Width="80" Height="32" IsCancel="True" />

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0" Orientation="Horizontal">
                    <CheckBox Content="استخدام ورق مروس" IsChecked="{Binding IsLetterhead}" VerticalAlignment="Center" Margin="0,0,20,10" FontWeight="SemiBold" />
                    
                    <TextBlock Text="تحريك عمودي:" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <Slider Width="100" Minimum="-80" Maximum="80" Value="{Binding ContentOffsetY}" VerticalAlignment="Center" Margin="0,0,20,10" />
                    
                    <TextBlock Text="تحريك أفقي:" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <Slider Width="100" Minimum="-80" Maximum="80" Value="{Binding ContentOffsetX}" VerticalAlignment="Center" Margin="0,0,20,10" />
                    
                    <TextBlock Text="مساحة الترويسة:" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <Slider Width="100" Minimum="0" Maximum="200" Value="{Binding TopMargin}" IsEnabled="{Binding IsLetterhead}" VerticalAlignment="Center" Margin="0,0,20,10" />
                    
                    <TextBlock Text="مساحة التذييل:" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <Slider Width="100" Minimum="0" Maximum="200" Value="{Binding BottomMargin}" VerticalAlignment="Center" Margin="0,0,20,10" />

                    <TextBlock Text="لون البرواز:" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <ComboBox Width="120" ItemsSource="{Binding FrameColors}" SelectedItem="{Binding SelectedFrameColor}" Height="28" VerticalAlignment="Center" Margin="0,0,20,10" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Padding="8">
            <DocumentViewer Document="{Binding PreviewDocument}" />
        </Border>
    </Grid>
</Window>
