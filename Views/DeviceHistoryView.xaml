<UserControl x:Class="BlueMax.Presentation.Wpf.Views.DeviceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="رجوع" />
            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Header="بحث السيريال">
                <StackPanel Margin="10" Orientation="Horizontal">
                    <TextBox Width="300" Text="{Binding SerialQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="بحث" Margin="10,0,0,0" Command="{Binding SearchHistoryCommand}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="سجل الجهاز" Margin="0,10,0,0">
                <DataGrid Margin="10"
                          ItemsSource="{Binding Timeline}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="120" />
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="140" />
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
