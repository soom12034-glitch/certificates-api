<Window x:Class="BlueMax.Presentation.Wpf.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفعيل البرنامج (محدث)" Height="400" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Right Side: Activation Form -->
        <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="تفعيل المنتج" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <TextBlock Text="بصمة الجهاز (أرسل هذا الرمز للمسؤول):" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtHardwareId" IsReadOnly="True" Background="#F0F0F0" Padding="5" FontSize="14" FontWeight="SemiBold"/>
            
            <TextBlock Text="رمز التفعيل:" Margin="0,15,0,5"/>
            <TextBox x:Name="TxtActivationCode" Padding="5" FontSize="16" FontFamily="Consolas" MaxLength="19" TextChanged="TxtActivationCode_TextChanged"/>
            
            <Button x:Name="BtnActivate" Content="تفعيل" Margin="0,20,0,0" Click="BtnActivate_Click" Height="40" FontSize="16"/>
            <TextBlock x:Name="TxtStatus" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Left Side: Image -->
        <Image Grid.Column="1" Source="pack://application:,,,/BlueMax.Presentation.Wpf;component/Assets/Images/Calibration3.png" Stretch="Uniform" Margin="10" />
    </Grid>
</Window>