<Window x:Class="BlueMax.Presentation.Wpf.Views.StickerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlueMax.Presentation.Wpf.Views"
        xmlns:converters="clr-namespace:BlueMax.Presentation.Wpf.Converters"
        Title="Sticker Preview"
        Width="700"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F5F5"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:QrCodeConverter x:Key="QrCodeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="QrTemplate">
            <Image Source="{Binding DisplayText, Converter={StaticResource QrCodeConverter}}" 
                   Stretch="Uniform" 
                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <TextBlock Text="{Binding DisplayText}" 
                       FontSize="{Binding FontSize}" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Left"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="company">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FlowDirection" Value="RightToLeft"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="header">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FlowDirection" Value="RightToLeft"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="brand_label">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="model_label">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="serial_label">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="cal_label">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="exp_label">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FlowDirection" Value="RightToLeft"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="address">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FlowDirection" Value="RightToLeft"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="phone">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FlowDirection" Value="LeftToRight"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="LogoTemplate">
            <Image Source="{Binding DisplayText}" 
                   Stretch="Uniform"
                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <DataTemplate x:Key="LineTemplate">
            <Border Background="Black" 
                    Height="{Binding Height}" 
                    Width="{Binding Width}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <views:StickerItemTemplateSelector x:Key="StickerTemplateSelector"
                                           LogoTemplate="{StaticResource LogoTemplate}"
                                           QrTemplate="{StaticResource QrTemplate}"
                                           LineTemplate="{StaticResource LineTemplate}"
                                           TextTemplate="{StaticResource TextTemplate}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F8F9FA" Padding="14" CornerRadius="8,8,0,0" Margin="10,10,10,0">
            <TextBlock Text="معاينة الملصق (Sticker Preview)" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" TextAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="10" Background="#DDDDDD" CornerRadius="0,0,8,8" Padding="20">
            <Viewbox Stretch="Uniform">
                <!-- Outer container to isolate FlowDirection -->
                <Border Background="White" 
                        BorderBrush="Black" 
                        BorderThickness="1"
                        Width="{Binding CanvasWidthPx}"
                        Height="{Binding CanvasHeightPx}"
                        FlowDirection="LeftToRight">
                    
                    <Grid x:Name="PreviewSurface">
                        <ItemsControl ItemsSource="{Binding StickerItems}">
                            <ItemsControl.Resources>
                                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="White" ClipToBounds="False"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Width" Value="{Binding Width}"/>
                                    <Setter Property="Height" Value="{Binding Height}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"
                                                     ContentTemplateSelector="{StaticResource StickerTemplateSelector}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Viewbox>
        </Border>
    </Grid>
</Window>
