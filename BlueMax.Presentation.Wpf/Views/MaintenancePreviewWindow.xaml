<Window x:Class="BlueMax.Presentation.Wpf.Views.MaintenancePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
        Title="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceOrderPreview}"
        Width="820"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceOrderPreview}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right" />
            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Close}" Width="120" Height="34" HorizontalAlignment="Left" IsCancel="True" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientDataPreview}" Margin="0,0,10,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNamePreview}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhonePreview}" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerPhone}" Margin="0,8,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceDataPreview}" Margin="10,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceTypePreview}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DeviceType}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ModelPreview}" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Model}" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialNumberPreview}" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SerialNumber}" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AccessoriesPreview}" Margin="0,8,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Accessories}" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </GroupBox>
                </Grid>

                <GroupBox Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusAndDates}" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusFieldPreview}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceivedDatePreview}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=UpdatedDatePreview}" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedDate, StringFormat=yyyy-MM-dd}" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalPreview}" Margin="0,8,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TotalCost}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ComplaintPreview}" Margin="0,0,0,10">
                    <TextBlock Margin="10" Text="{Binding Complaint}" TextWrapping="Wrap" />
                </GroupBox>

                <GroupBox Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TechnicalReportPreview}">
                    <TextBlock Margin="10" Text="{Binding TechnicalReport}" TextWrapping="Wrap" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
