<UserControl x:Class="BlueMax.Presentation.Wpf.Views.StickerDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             xmlns:converters="clr-namespace:BlueMax.Presentation.Wpf.Converters"
             xmlns:views="clr-namespace:BlueMax.Presentation.Wpf.Views"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StickerDesignerViewModel}"
             Background="#F5F5F5"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <converters:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter"/>
        <converters:BooleanToFontStyleConverter x:Key="BooleanToFontStyleConverter"/>
        <converters:BooleanToTextDecorationsConverter x:Key="BooleanToTextDecorationsConverter"/>

        <DataTemplate x:Key="LogoTemplate">
            <Image Source="{Binding DisplayText, Converter={StaticResource ImagePathToBitmapConverter}, IsAsync=True}" Stretch="Uniform"/>
        </DataTemplate>
        <DataTemplate x:Key="TextTemplate">
            <TextBlock Text="{Binding DisplayText}" 
                       FontSize="{Binding FontSize}" 
                       FontFamily="{Binding FontFamily}"
                       Foreground="{Binding FontColor, Converter={StaticResource StringToBrushConverter}}"
                       TextWrapping="Wrap"
                       TextAlignment="{Binding TextAlignment}"
                       FontWeight="{Binding IsBold, Converter={StaticResource BooleanToFontWeightConverter}}"
                       FontStyle="{Binding IsItalic, Converter={StaticResource BooleanToFontStyleConverter}}"
                       TextDecorations="{Binding IsUnderline, Converter={StaticResource BooleanToTextDecorationsConverter}}"/>
        </DataTemplate>
        <DataTemplate x:Key="LineTemplate">
            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="Black"/>
        </DataTemplate>
        <DataTemplate x:Key="QrTemplate">
            <Border Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="QR" FontSize="12" FontWeight="Bold" Foreground="#475569"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <views:StickerItemTemplateSelector x:Key="StickerTemplateSelector"
                                           LogoTemplate="{StaticResource LogoTemplate}"
                                           QrTemplate="{StaticResource QrTemplate}"
                                           LineTemplate="{StaticResource LineTemplate}"
                                           TextTemplate="{StaticResource TextTemplate}"/>

        <Style x:Key="DesignerThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#16A085"/>
                    <Setter Property="Background" Value="#1016A085"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb" BasedOn="{StaticResource DesignerThumbStyle}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16A085"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Preview -->
        <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F9FAFB" Padding="20,16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerPreview}" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="-" Command="{Binding ZoomOutCommand}" Width="36" Height="36" Margin="0,0,8,0" 
                                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1" FontSize="18" FontWeight="Bold" Cursor="Hand"/>
                            <TextBlock Text="{Binding Zoom, StringFormat={}{0:F1}x}" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0" Width="40" TextAlignment="Center"/>
                            <Button Content="+" Command="{Binding ZoomInCommand}" Width="36" Height="36" 
                                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1" FontSize="18" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                              Padding="24" Background="#F3F4F6">
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}" Background="White" FlowDirection="RightToLeft">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                            </Grid.LayoutTransform>
                            <Canvas x:Name="StickerCanvas"
                                    Width="{Binding CanvasWidthPx}"
                                    Height="{Binding CanvasHeightPx}"
                                    Background="White"/>
                            <Canvas x:Name="GridOverlay"
                                    Width="{Binding CanvasWidthPx}"
                                    Height="{Binding CanvasHeightPx}"
                                    IsHitTestVisible="False"
                                    Background="Transparent"/>
                            <ItemsControl ItemsSource="{Binding StickerItems}" Width="{Binding CanvasWidthPx}" Height="{Binding CanvasHeightPx}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas ClipToBounds="False"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}" FlowDirection="RightToLeft">
                                            <Thumb Name="DragThumb" Style="{StaticResource DesignerThumbStyle}"
                                                   Tag="{Binding}"
                                                   Cursor="SizeAll"
                                                   IsHitTestVisible="{Binding DataContext.EditEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   DragDelta="StickerThumb_OnDragDelta"
                                                   MouseLeftButtonDown="StickerThumb_OnMouseLeftButtonDown"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplateSelector="{StaticResource StickerTemplateSelector}"
                                                            IsHitTestVisible="False"/>
                                            <Thumb Name="ResizeThumb"
                                                   Style="{StaticResource ResizeThumbStyle}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Tag="{Binding}"
                                                   IsHitTestVisible="{Binding DataContext.EditEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   DragDelta="StickerResizeThumb_OnDragDelta"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Panel - Tools -->
        <Border Grid.Column="1" Background="White" Margin="8,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerDesigner}" 
                           FontSize="22" FontWeight="SemiBold" Foreground="#111827" Margin="20,20,20,16"/>
                
                <TabControl Grid.Row="1" BorderThickness="0" Padding="8,0,8,8" Background="Transparent">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" 
                                                CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            ContentSource="Header" RecognizesAccessKey="True"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    
                    <!-- Tab 1: إعدادات الصفحة -->
                    <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PageTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <!-- Page Settings -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PageTab}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=WidthMm}" 
                                                       FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding StickerWidthMm, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="36" Padding="10,8" FontSize="13" BorderBrush="#D1D5DB" BorderThickness="1" 
                                                     Background="White" HorizontalAlignment="Right" Width="120"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HeightMm}" 
                                                       FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding StickerHeightMm, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="36" Padding="10,8" FontSize="13" BorderBrush="#D1D5DB" BorderThickness="1" 
                                                     Background="White" HorizontalAlignment="Right" Width="120"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveAsTemplate}" FontSize="12" Foreground="#6B7280" Margin="0,8,0,4"/>
                                        <WrapPanel>
                                            <Button Content="50x30" Command="{Binding ApplySizeTemplateCommand}" CommandParameter="50x30" 
                                                    Background="#E5E7EB" Foreground="#374151" Height="32" FontSize="12" 
                                                    BorderThickness="0" Margin="0,0,8,8" Padding="12,0" Cursor="Hand"/>
                                            <Button Content="60x40" Command="{Binding ApplySizeTemplateCommand}" CommandParameter="60x40" 
                                                    Background="#E5E7EB" Foreground="#374151" Height="32" FontSize="12" 
                                                    BorderThickness="0" Margin="0,0,8,8" Padding="12,0" Cursor="Hand"/>
                                            <Button Content="70x50" Command="{Binding ApplySizeTemplateCommand}" CommandParameter="70x50" 
                                                    Background="#E5E7EB" Foreground="#374151" Height="32" FontSize="12" 
                                                    BorderThickness="0" Margin="0,0,8,8" Padding="12,0" Cursor="Hand"/>
                                            <Button Content="80x60" Command="{Binding ApplySizeTemplateCommand}" CommandParameter="80x60" 
                                                    Background="#E5E7EB" Foreground="#374151" Height="32" FontSize="12" 
                                                    BorderThickness="0" Margin="0,0,8,8" Padding="12,0" Cursor="Hand"/>
                                            <Button Content="100x70" Command="{Binding ApplySizeTemplateCommand}" CommandParameter="100x70" 
                                                    Background="#E5E7EB" Foreground="#374151" Height="32" FontSize="12" 
                                                    BorderThickness="0" Margin="0,0,8,8" Padding="12,0" Cursor="Hand"/>
                                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveAsTemplate}" Command="{Binding SaveCustomTemplateCommand}" 
                                                    Background="#10B981" Foreground="White" Height="32" FontSize="12" 
                                                    BorderThickness="0" Padding="12,0" Cursor="Hand"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Grid Settings -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=GridTab}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ShowPreviewGrid}" 
                                                  IsChecked="{Binding ShowGrid}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                        <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SnapToGrid}" 
                                                  IsChecked="{Binding SnapToGrid}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                        <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EnableMouseEditing}" 
                                                  IsChecked="{Binding EditEnabled}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- Tab 2: المحتوى -->
                    <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ContentTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <!-- Header Settings -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HeaderTab}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=UseLogo}" 
                                                  IsChecked="{Binding UseLogo}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HeaderTitle}" 
                                                   FontSize="12" Foreground="#6B7280" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding CompanyHeader}" Height="36" Padding="10,8" FontSize="13" 
                                                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerCompanyName}" 
                                                   FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CompanyName}" Height="36" Padding="10,8" FontSize="13" 
                                                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Content Settings -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ContentTab}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ContentHeaderCompanyName}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CompanyName}" Height="36" Padding="10,8" FontSize="13" 
                                                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ContentHeaderAddress}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CompanyAddress}" Height="36" Padding="10,8" FontSize="13" 
                                                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ContentHeaderPhone}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CompanyPhone}" Height="36" Padding="10,8" FontSize="13" 
                                                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Logo Settings -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=LogoSettings}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=UseLogoText}" 
                                                  IsChecked="{Binding UseLogo}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PickLogo}" 
                                                Command="{Binding PickLogoCommand}" 
                                                Background="#3B82F6" Foreground="White" Height="36" FontSize="13" FontWeight="SemiBold" 
                                                BorderThickness="0" Margin="0,8,0,0" Cursor="Hand"/>
                                    </StackPanel>
                                </Border>

                                <!-- QR Settings -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=QrLabel}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ShowQrInPreview}" 
                                                  IsChecked="{Binding ShowQr}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=QrSizeMm}" FontSize="12" Foreground="#6B7280" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding QrSizeMm, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,8" FontSize="13" 
                                                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- Tab 3: العناصر -->
                    <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ItemTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <!-- Add Items -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddItems}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddTextItem}" Command="{Binding AddTextItemCommand}" 
                                                    Background="#3B82F6" Foreground="White" Height="36" FontSize="13" FontWeight="SemiBold" 
                                                    BorderThickness="0" Margin="0,0,8,0" Padding="16,0" Cursor="Hand"/>
                                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddLineItem}" Command="{Binding AddLineItemCommand}" 
                                                    Background="#6B7280" Foreground="White" Height="36" FontSize="13" FontWeight="SemiBold" 
                                                    BorderThickness="0" Margin="0,0,8,0" Padding="16,0" Cursor="Hand"/>
                                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeleteSelectedItem}" Command="{Binding DeleteSelectedItemCommand}" 
                                                    Background="#EF4444" Foreground="White" Height="36" FontSize="13" FontWeight="SemiBold" 
                                                    BorderThickness="0" Padding="16,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Selected Item Properties -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SelectedItemProperties}" 
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,12"/>
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ItemNameLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding SelectedStickerItem.Key}" FontSize="13" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PositionX}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.X, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PositionY}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.Y, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=WidthLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.Width, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HeightLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.Height, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=FontSizeLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.FontSize, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=FontFamilyLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <ComboBox Text="{Binding SelectedStickerItem.FontFamily, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                      BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Segoe UI"/>
                                                <ComboBoxItem Content="Arial"/>
                                                <ComboBoxItem Content="Times New Roman"/>
                                                <ComboBoxItem Content="Calibri"/>
                                                <ComboBoxItem Content="Cairo"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=FontColorLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <TextBox Text="{Binding SelectedStickerItem.FontColor, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,8,40,8" FontSize="12" 
                                                         BorderBrush="#D1D5DB" BorderThickness="1" Background="White"/>
                                                <Border Width="24" Height="24" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                        BorderBrush="#D1D5DB" BorderThickness="1" Background="{Binding SelectedStickerItem.FontColor, Converter={StaticResource StringToBrushConverter}}"/>
                                            </Grid>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AlignmentLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <ComboBox SelectedItem="{Binding SelectedStickerItem.TextAlignment, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                      BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Right"/>
                                                <ComboBoxItem Content="Center"/>
                                                <ComboBoxItem Content="Left"/>
                                            </ComboBox>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=BoldLabel}" IsChecked="{Binding SelectedStickerItem.IsBold}" Margin="0,0,12,0" FontSize="13" Foreground="#4B5563"/>
                                                <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ItalicLabel}" IsChecked="{Binding SelectedStickerItem.IsItalic}" Margin="0,0,12,0" FontSize="13" Foreground="#4B5563"/>
                                                <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=UnderlineLabel}" IsChecked="{Binding SelectedStickerItem.IsUnderline}" FontSize="13" Foreground="#4B5563"/>
                                            </StackPanel>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TextLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.DisplayText, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=BindToVariableLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <ComboBox Text="{Binding SelectedStickerItem.VariableBinding, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                      BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="brand"/>
                                                <ComboBoxItem Content="model"/>
                                                <ComboBoxItem Content="serial"/>
                                                <ComboBoxItem Content="cert_value"/>
                                                <ComboBoxItem Content="cal_value"/>
                                                <ComboBoxItem Content="exp_value"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ZIndexLabel}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedStickerItem.ZIndex, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8" FontSize="12" 
                                                     BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Margin="0,0,0,8"/>
                                            
                                            <CheckBox Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ItemVisibility}" IsChecked="{Binding SelectedStickerItem.IsVisible}" Margin="0,6" FontSize="13" Foreground="#4B5563"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- Tab 4: الإجراءات -->
                    <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActionsTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveLayout}" 
                                        Command="{Binding SaveLayoutCommand}" 
                                        Background="#10B981" Foreground="White" Height="44" FontSize="14" FontWeight="SemiBold" 
                                        BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="8" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ResetLayout}" 
                                        Command="{Binding ResetLayoutCommand}" 
                                        Background="#6B7280" Foreground="White" Height="44" FontSize="14" FontWeight="SemiBold" 
                                        BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="8" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4B5563"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TestPrint}" 
                                        Command="{Binding TestPrintCommand}" 
                                        Background="#F59E0B" Foreground="White" Height="44" FontSize="14" FontWeight="SemiBold" 
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="8" 
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D97706"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
