<Window x:Class="BlueMax.Presentation.Wpf.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
        Title="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActivationTitle}" Height="400" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Right Side: Activation Form -->
        <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ProductActivation}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HardwareFingerprint}" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtHardwareId" IsReadOnly="True" Background="#F0F0F0" Padding="5" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#B0B0B0"/>
                <Button Grid.Column="1" x:Name="BtnCopyHardwareId" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CopyButton}" Margin="8,0,0,0" Padding="14,6" Click="BtnCopyHardwareId_Click"/>
            </Grid>
            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HardwareIdHint}" Foreground="#777777" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            
            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActivationCode}" Margin="0,15,0,5"/>
            <TextBox x:Name="TxtActivationCode" Padding="5" FontSize="16" FontFamily="Consolas" MaxLength="19" TextChanged="TxtActivationCode_TextChanged"/>
            
            <Button x:Name="BtnActivate" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Activate}" Margin="0,20,0,0" Click="BtnActivate_Click" Height="40" FontSize="16"/>
            <TextBlock x:Name="TxtStatus" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Left Side: Image -->
        <Image Grid.Column="1" Source="pack://application:,,,/BlueMax.Presentation.Wpf;component/Assets/Images/Calibration3.png" Stretch="Uniform" Margin="10" />
    </Grid>
</Window>