<UserControl x:Class="BlueMax.Presentation.Wpf.Views.RentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Rentals}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Grid.Column="1"
                    Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Back}" />
            </Button>
        </Grid>

        <!-- Alert Banner -->
        <Border Grid.Row="0" Margin="0,40,0,15" 
                Background="{DynamicResource DangerLightBrush}" 
                CornerRadius="8" 
                Padding="12"
                Visibility="{Binding HasExpiredRentals, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconClock}" Style="{StaticResource AppIconStyle}" Fill="White" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ExpiredRentalsCount}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExpiredStatus}" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Expiring Soon Banner -->
        <Border Grid.Row="0" Margin="0,75,0,15" 
                Background="{DynamicResource WarningBrush}" 
                CornerRadius="8" 
                Padding="12"
                Visibility="{Binding HasExpiringSoonRentals, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconClock}" Style="{StaticResource AppIconStyle}" Fill="White" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ExpiringSoonRentalsCount}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExpiringSoonRentals}" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CreateNewRental}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Section (Sidebar) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=NewRentalForm}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Company}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TaxNumberField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=IdNumber}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand}" IsEditable="True" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MainSerial}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Serial2Optional}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding Serial2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" IsEnabled="{Binding IsGpsDevice}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StartDateField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <DatePicker SelectedDate="{Binding StartDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EndDateField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <DatePicker SelectedDate="{Binding EndDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalType}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding RentalTypes}" SelectedItem="{Binding RentalType}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DailyPrice}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding DailyPrice, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MonthlyPrice}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding MonthlyPrice, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceValue}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding DeviceValue, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PriceField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PaidAmount}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RemainingAmount}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding RemainingAmount, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNotes}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=NewButton}" Width="80" Height="35" Margin="0,0,8,0" Command="{Binding NewRentalCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource TextDisabledBrush}" />
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveButton}" Width="80" Height="35" Margin="0,0,8,0" Command="{Binding SaveRentalCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource GreenGradient}" />
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeleteButton}" Width="80" Height="35" Command="{Binding DeleteRentalCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons Section -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActionsSection}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintRentalReceipt}" 
                                    Command="{Binding PrintRentalReceiptCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource CyanGradient}"
                                    Margin="0,0,0,8"/>
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintRentalContract}" 
                                    Command="{Binding PrintRentalContractCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource PrimaryVioletBrush}"
                                    Margin="0,0,0,8"/>
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HandoverReceiptButton}" 
                                    Command="{Binding PrintRentalHandoverCommand}" 
                                    CommandParameter="Receive"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource InfoBlueBrush}"
                                    Margin="0,0,0,8">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiveReceiptTitle}"
                                                  Command="{Binding PrintRentalHandoverCommand}"
                                                  CommandParameter="Receive"/>
                                        <MenuItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReturnReceiptTitle}"
                                                  Command="{Binding PrintRentalHandoverCommand}"
                                                  CommandParameter="Return"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CompleteRental}" 
                                    Command="{Binding CompleteRentalCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource OrangeGradient}"
                                    Margin="0,0,0,8"/>
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Edit}" 
                                    Command="{Binding EditRentalCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=History}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="14" Height="40" Padding="10,10" 
                                     VerticalContentAlignment="Center" 
                                     Foreground="Black" Background="White" 
                                     BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" 
                                     FontFamily="Cairo, Segoe UI"
                                     ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" />
                            <Button Grid.Column="1" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" Width="80" Height="40" Margin="8,0,0,0" Command="{Binding SearchCommand}" Style="{StaticResource ModernButtonStyle}" />
                            <Button Grid.Column="2" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintReceipt}" Width="120" Height="40" Margin="8,0,0,0" Command="{Binding PrintRentalReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource CyanGradient}"/>
                        </Grid>

                        <!-- DataGrid -->
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding Rentals}" 
                                      SelectedItem="{Binding SelectedRental}"
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      CanUserAddRows="False"
                                      FontFamily="Cairo, Segoe UI"
                                      FontSize="13"
                                      RowBackground="White"
                                      AlternatingRowBackground="{DynamicResource SurfaceSoftBrush}"
                                      BorderBrush="{DynamicResource BorderLightBrush}"
                                      BorderThickness="1"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalNumber}" Binding="{Binding RentalNumber}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="*" MinWidth="150" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Binding="{Binding Phone}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Binding="{Binding Brand}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialField}" Binding="{Binding Serial}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StartDateField}" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EndDateField}" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PriceField}" Binding="{Binding Price}" Width="*" MinWidth="80" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Binding="{Binding Status}" Width="*" MinWidth="80" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Busy indicator -->
                            <Grid Panel.ZIndex="100"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource BusyOverlayStyle}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BusyMessage}" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource EmptyStateTextStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty state -->
                            <TextBlock Panel.ZIndex="50"
                                       Style="{StaticResource EmptyStateTextStyle}"
                                       Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=[NoDataAvailable]}">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}">
                                        <Binding Path="Rentals.Count"/>
                                        <Binding Path="IsBusy"/>
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CurrentlyRentedDevices}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CurrentlyRentedDevices}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding ActiveRentals}" 
                                  SelectedItem="{Binding SelectedRental}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  FontFamily="Cairo, Segoe UI"
                                  FontSize="13"
                                  RowBackground="White"
                                  AlternatingRowBackground="{DynamicResource SurfaceSoftBrush}"
                                  BorderBrush="{DynamicResource BorderLightBrush}"
                                  BorderThickness="1"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalNumber}" Binding="{Binding RentalNumber}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Binding="{Binding Phone}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="*" MinWidth="120" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Binding="{Binding Brand}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialField}" Binding="{Binding Serial}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StartDateField}" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EndDateField}" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PriceField}" Binding="{Binding Price}" Width="*" MinWidth="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Busy indicator -->
                        <Grid Grid.Row="1" Panel.ZIndex="100"
                              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource BusyOverlayStyle}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BusyMessage}" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource EmptyStateTextStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="1" Panel.ZIndex="50"
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=[NoDataAvailable]}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}">
                                    <Binding Path="ActiveRentals.Count"/>
                                    <Binding Path="IsBusy"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalReport}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalStatistics}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="{DynamicResource InfoBlueBrush}" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalRentals}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding TotalRentals}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CurrentlyActive}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding ActiveRentalsCount}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExpiredStatus}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding ExpiredRentalsCount}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="3" Background="{DynamicResource PrimaryVioletBrush}" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalIncome}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding TotalIncome}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
