<UserControl x:Class="BlueMax.Presentation.Wpf.Views.RentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Rentals}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Grid.Column="1"
                    Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Back}" />
            </Button>
        </Grid>

        <!-- Alert Banner -->
        <Border Grid.Row="0" Margin="0,40,0,15" 
                Background="#FF5252" 
                CornerRadius="8" 
                Padding="12"
                Visibility="{Binding HasExpiredRentals, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ExpiredRentalsCount}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExpiredStatus}" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CreateNewRental}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Section (Sidebar) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=NewRentalForm}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Company}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TaxNumberField}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=IdNumber}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand}" IsEditable="True" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MainSerial}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Serial2Optional}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding Serial2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" IsEnabled="{Binding IsGpsDevice}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StartDateField}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <DatePicker SelectedDate="{Binding StartDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EndDateField}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <DatePicker SelectedDate="{Binding EndDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalType}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding RentalTypes}" SelectedItem="{Binding RentalType}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PriceField}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PaidAmount}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RemainingAmount}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding RemainingAmount, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNotes}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=NewButton}" Width="80" Height="35" Margin="0,0,8,0" Command="{Binding NewRentalCommand}" Style="{StaticResource ModernButtonStyle}" Background="#9CA3AF" />
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveButton}" Width="80" Height="35" Margin="0,0,8,0" Command="{Binding SaveRentalCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource GreenGradient}" />
                                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeleteButton}" Width="80" Height="35" Command="{Binding DeleteRentalCommand}" Style="{StaticResource ModernButtonStyle}" Background="#EF4444" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons Section -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActionsSection}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintRentalReceipt}" 
                                    Command="{Binding PrintRentalReceiptCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource CyanGradient}"
                                    Margin="0,0,0,8"/>
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CompleteRental}" 
                                    Command="{Binding CompleteRentalCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="{DynamicResource OrangeGradient}"
                                    Margin="0,0,0,8"/>
                            
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Edit}" 
                                    Command="{Binding EditRentalCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="#9CA3AF"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=History}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="14" Height="40" Padding="10,10" 
                                     VerticalContentAlignment="Center" 
                                     Foreground="Black" Background="White" 
                                     BorderBrush="#E5E7EB" BorderThickness="1" 
                                     FontFamily="Cairo, Segoe UI"
                                     ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" />
                            <Button Grid.Column="1" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" Width="80" Height="40" Margin="8,0,0,0" Command="{Binding SearchCommand}" Style="{StaticResource ModernButtonStyle}" />
                            <Button Grid.Column="2" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintReceipt}" Width="120" Height="40" Margin="8,0,0,0" Command="{Binding PrintRentalReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource CyanGradient}"/>
                        </Grid>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding Rentals}" 
                                  SelectedItem="{Binding SelectedRental}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  FontFamily="Cairo, Segoe UI"
                                  FontSize="13"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB"
                                  BorderBrush="#E5E7EB"
                                  BorderThickness="1"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalNumber}" Binding="{Binding RentalNumber}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="150" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Binding="{Binding Phone}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="120" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Binding="{Binding Brand}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialField}" Binding="{Binding Serial}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StartDateField}" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EndDateField}" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PriceField}" Binding="{Binding Price}" Width="80" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Binding="{Binding Status}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CurrentlyRentedDevices}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CurrentlyRentedDevices}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding ActiveRentals}" 
                                  SelectedItem="{Binding SelectedRental}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  FontFamily="Cairo, Segoe UI"
                                  FontSize="13"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9FAFB"
                                  BorderBrush="#E5E7EB"
                                  BorderThickness="1"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalNumber}" Binding="{Binding RentalNumber}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="150" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Binding="{Binding Phone}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="120" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Binding="{Binding Brand}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialField}" Binding="{Binding Serial}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StartDateField}" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=EndDateField}" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PriceField}" Binding="{Binding Price}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalReport}">
                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RentalStatistics}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#3B82F6" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalRentals}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding TotalRentals}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Background="#10B981" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CurrentlyActive}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding ActiveRentalsCount}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Background="#F59E0B" CornerRadius="8" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExpiredStatus}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding ExpiredRentalsCount}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="3" Background="#8B5CF6" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalIncome}" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{Binding TotalIncome}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
