<Window x:Class="BlueMax.Presentation.Wpf.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HelpSystem}" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        FlowDirection="RightToLeft"
        FontFamily="Cairo 2026, Segoe UI">
    
    <Window.DataContext>
        <viewmodels:HelpViewModel/>
    </Window.DataContext>
    <Window.Resources>
    </Window.Resources>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان والبحث -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HelpTitle}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#1F2937"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="250" 
                             Height="36" 
                             Padding="10,8" 
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D1D5DB" 
                             BorderThickness="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- القائمة الجانبية -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HelpCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="16,12" 
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- منطقة المحتوى -->
            <Border Grid.Column="1" Background="White" Padding="32">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedContent}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="#1F2937" 
                                               Margin="0,0,0,20"/>
                                    
                                    <TextBlock Text="{Binding Content}" 
                                               FontSize="14" 
                                               Foreground="#4B5563" 
                                               TextWrapping="Wrap"
                                               LineHeight="24"/>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- شريط الأزرار السفلية -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HelpPrintGuide}" 
                        Width="120" 
                        Height="36" 
                        Margin="0,0,8,0"
                        Background="#10B981" 
                        Foreground="White" 
                        BorderThickness="0"
                        Command="{Binding PrintCommand}"/>
                
                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HelpExportPdf}" 
                        Width="120" 
                        Height="36" 
                        Margin="0,0,8,0"
                        Background="#3B82F6" 
                        Foreground="White" 
                        BorderThickness="0"
                        Command="{Binding ExportPdfCommand}"/>
                
                <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Close}" 
                        Width="100" 
                        Height="36" 
                        Background="#6B7280" 
                        Foreground="White" 
                        BorderThickness="0"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
