<UserControl x:Class="BlueMax.Presentation.Wpf.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Maintenance}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Grid.Column="1"
                    Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Back}" />
            </Button>
        </Grid>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceOrders}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Section (Sidebar) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceOrder}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand}" IsEditable="True" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialNumber1}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Serial2Optional}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                            <TextBox Text="{Binding SerialNumber2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" IsEnabled="{Binding IsGpsDevice}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Accessories}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding Accessories, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Complaint}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TechnicalReport}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding TechnicalReport, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PartsCost}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                            <TextBox Text="{Binding PartsCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=LaborCost}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                            <TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Total}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                    <TextBox Text="{Binding TotalCost, Mode=OneWay}" IsReadOnly="True" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptDate}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                            <DatePicker SelectedDate="{Binding ReceivedDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=UpdateDate}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo 2026, Segoe UI" />
                                            <DatePicker SelectedDate="{Binding UpdatedDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Foreground="Black" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" FontFamily="Cairo 2026, Segoe UI" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=NewButton}" Width="55" Margin="2" Command="{Binding NewWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Edit}" Width="55" Margin="2" Command="{Binding EditWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveButton}" Width="55" Margin="2" Command="{Binding SaveWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddDeviceForSameCustomer}" Width="130" Margin="2" Command="{Binding AddDeviceToSameReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF4CAF50" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddDeviceTooltip}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeleteButton}" Width="55" Margin="2" Command="{Binding DeleteWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF5252" Foreground="White" />
                                </StackPanel>
                                <Separator Background="#30FFFFFF" Margin="0,5,0,5" />
                                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActionsSection}" Foreground="White" FontWeight="SemiBold" Margin="0,5" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ShowPrice}" Width="80" Margin="2" Command="{Binding GenerateQuotationCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ShowPriceTooltip}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=IndividualReceipt}" Width="80" Margin="2" Command="{Binding GenerateInvoiceCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Report}" Width="80" Margin="2" Command="{Binding GenerateMaintenanceReportCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceReportTooltip}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Preview}" Width="80" Margin="2" Command="{Binding PreviewWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PreviewTooltip}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptSticker}" Width="110" Margin="2" Command="{Binding PrintReceiptCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerTooltip}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Section (Main Content) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceRequests}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <TextBox Grid.Column="1" Margin="10,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" />

                                <Button Grid.Column="2" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Refresh}" Command="{Binding RefreshWorkOrdersCommand}" Style="{StaticResource ModernButtonStyle}" Width="100" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding WorkOrders}"
                                      SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      MouseDoubleClick="OnWorkOrdersDoubleClick"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      BorderThickness="1"
                                      BorderBrush="#EEEEEE">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptNumber}" Binding="{Binding ReceiptGroupNumber}" Width="90" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="1.5*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Binding="{Binding Model}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialField}" Binding="{Binding SerialNumber}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptDate}" Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerTab}">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintReceiptSticker}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerNote}" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerSize}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerSettings}"
                                    Width="280"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Command="{Binding OpenReceiptStickerSettingsCommand}"
                                    Style="{StaticResource ModernButtonStyle}" />
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintNow}"
                                    Width="140"
                                    Height="36"
                                    Command="{Binding PrintReceiptStickerCommand}"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerExtraNote}" TextWrapping="Wrap" FontSize="13" Foreground="#374151" />
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
