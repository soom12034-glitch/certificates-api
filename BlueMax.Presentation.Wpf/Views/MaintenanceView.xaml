<UserControl x:Class="BlueMax.Presentation.Wpf.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Maintenance}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" />
            <Button Grid.Column="1"
                    Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Back}" />
            </Button>
        </Grid>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceOrders}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Section (Sidebar) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceOrder}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding Brand}" IsEditable="True" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialNumber1}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Serial2Optional}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding SerialNumber2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" IsEnabled="{Binding IsGpsDevice}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Accessories}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Accessories, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Complaint}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TechnicalReport}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding TechnicalReport, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Padding="10,10" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PartsCost}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding PartsCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=LaborCost}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <TextBox Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsInputsLocked}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Total}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                    <TextBox Text="{Binding TotalCost, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptDate}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <DatePicker SelectedDate="{Binding ReceivedDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=UpdateDate}" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                                            <DatePicker SelectedDate="{Binding UpdatedDate}" IsEnabled="{Binding IsInputsEditable}" FontSize="14" Height="40" Foreground="Black" Background="White" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" FontFamily="Cairo, Segoe UI" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=NewButton}" Width="55" Margin="2" Command="{Binding NewWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Edit}" Width="55" Margin="2" Command="{Binding EditWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveButton}" Width="55" Margin="2" Command="{Binding SaveWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Width="130" Margin="2" Command="{Binding AddDeviceToSameReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource SuccessBrightBrush}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddDeviceTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource AppIconStyle}" Fill="White" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=AddDeviceForSameCustomer}" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeleteButton}" Width="55" Margin="2" Command="{Binding DeleteWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource DangerLightBrush}" Foreground="White" />
                                </StackPanel>
                                <Separator Background="{DynamicResource OverlayWhiteBrush}" Margin="0,5,0,5" />
                                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ActionsSection}" Foreground="White" FontWeight="SemiBold" Margin="0,5" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ShowPrice}" Width="80" Margin="2" Command="{Binding GenerateQuotationCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ShowPriceTooltip}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=IndividualReceipt}" Width="80" Margin="2" Command="{Binding GenerateInvoiceCommand}" Style="{StaticResource ModernButtonStyle}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Report}" Width="80" Margin="2" Command="{Binding GenerateMaintenanceReportCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceReportTooltip}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Preview}" Width="80" Margin="2" Command="{Binding PreviewWorkOrderCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PreviewTooltip}" />
                                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptSticker}" Width="110" Margin="2" Command="{Binding PrintReceiptCommand}" Style="{StaticResource ModernButtonStyle}" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerTooltip}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Section (Main Content) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceRequests}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <TextBox Grid.Column="1" Margin="10,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" />

                                <Button Grid.Column="2" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Refresh}" Command="{Binding RefreshWorkOrdersCommand}" Style="{StaticResource ModernButtonStyle}" Width="100" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding WorkOrders}"
                                      SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      MouseDoubleClick="OnWorkOrdersDoubleClick"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource SurfaceMutedBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptNumber}" Binding="{Binding ReceiptGroupNumber}" Width="*" MinWidth="90" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="1.5*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Binding="{Binding Model}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SerialField}" Binding="{Binding SerialNumber}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptDate}" Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Busy indicator -->
                            <Grid Grid.Row="1" Panel.ZIndex="100"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource BusyOverlayStyle}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BusyMessage}" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource EmptyStateTextStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Empty state -->
                            <TextBlock Grid.Row="1" Panel.ZIndex="50"
                                       Style="{StaticResource EmptyStateTextStyle}"
                                       Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=[NoDataAvailable]}">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}">
                                        <Binding Path="WorkOrders.Count"/>
                                        <Binding Path="IsBusy"/>
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerTab}">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintReceiptSticker}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerNote}" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerSize}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerSettings}"
                                    Width="280"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Command="{Binding OpenReceiptStickerDesignerCommand}"
                                    Style="{StaticResource ModernButtonStyle}" />
                            <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintNow}"
                                    Width="140"
                                    Height="36"
                                    Command="{Binding PrintReceiptStickerCommand}"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptStickerExtraNote}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceReportsTab}">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Filter bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReportsFrom}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ReportsFromDate}" FontSize="14" Width="140" />
                            <TextBlock Grid.Column="2" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReportsTo}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <DatePicker Grid.Column="3" SelectedDate="{Binding ReportsToDate}" FontSize="14" Width="140" />
                            <Button Grid.Column="4" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Refresh}" Command="{Binding RefreshReportsCommand}" Style="{StaticResource ModernButtonStyle}" Width="90" Margin="12,0,0,0" />
                            <Button Grid.Column="6" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExportPdf}" Command="{Binding ExportReportsPdfCommand}" Style="{StaticResource ModernButtonStyle}" Width="110" />
                            <Button Grid.Column="7" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ExportExcel}" Command="{Binding ExportReportsExcelCommand}" Style="{StaticResource ModernButtonStyle}" Width="110" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Summary cards -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                            <Border Height="110" Margin="0,0,12,0" Style="{StaticResource StatCardStyle}" Background="{DynamicResource CyanGradient}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalOrders}" Foreground="White" FontSize="14" Opacity="0.9" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalOrdersCount}" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Height="110" Margin="12,0" Style="{StaticResource StatCardStyle}" Background="{DynamicResource OrangeGradient}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=OrdersInProgress}" Foreground="White" FontSize="14" Opacity="0.9" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding InProgressCount}" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Height="110" Margin="12,0" Style="{StaticResource StatCardStyle}" Background="{DynamicResource GreenGradient}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CompletedDelivered}" Foreground="White" FontSize="14" Opacity="0.9" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CompletedDeliveredCount}" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Height="110" Margin="12,0,0,0" Style="{StaticResource StatCardStyle}" Background="{DynamicResource PurpleGradient}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalIncome}" Foreground="White" FontSize="14" Opacity="0.9" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ReportsTotalIncome, StringFormat=N2}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Breakdown grids -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusBreakdown}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />
                                    <DataGrid ItemsSource="{Binding ReportStatusBreakdown}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Binding="{Binding Status}" Width="*" />
                                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=OrdersCount}" Binding="{Binding Count}" Width="Auto" />
                                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalCostColumn}" Binding="{Binding TotalCost, StringFormat=N2}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MonthlyBreakdown}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />
                                    <DataGrid ItemsSource="{Binding ReportMonthBreakdown}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MonthColumn}" Binding="{Binding MonthLabel}" Width="*" />
                                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=OrdersCount}" Binding="{Binding Count}" Width="Auto" />
                                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=TotalCostColumn}" Binding="{Binding TotalCost, StringFormat=N2}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Orders detail -->
                        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,15,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceRequests}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding ReportsOrders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceiptNumber}" Binding="{Binding ReceiptGroupNumber}" Width="*" MinWidth="80" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNameField}" Binding="{Binding CustomerName}" Width="1.5*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceType}" Binding="{Binding DeviceType}" Width="*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Brand}" Binding="{Binding Brand}" Width="*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Binding="{Binding Model}" Width="*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StatusField}" Binding="{Binding Status}" Width="*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PartsCost}" Binding="{Binding PartsCost, StringFormat=N2}" Width="*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=LaborCost}" Binding="{Binding LaborCost, StringFormat=N2}" Width="*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Total}" Binding="{Binding TotalCost, StringFormat=N2}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Busy overlay -->
                        <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding IsReportsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource BusyOverlayStyle}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ReportsBusyMessage}" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource EmptyStateTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
