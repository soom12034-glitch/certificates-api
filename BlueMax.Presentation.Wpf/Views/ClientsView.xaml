<UserControl x:Class="BlueMax.Presentation.Wpf.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             Background="Transparent"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Back Button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Style="{StaticResource CapsuleButtonStyle}"
                    Command="{Binding DataContext.ShowHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Back}" />
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" /> <!-- Input Section (Sidebar) -->
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.5*" />  <!-- History Section (Middle) -->
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />  <!-- Clients List (Right/End) -->
            </Grid.ColumnDefinitions>

            <!-- Input Section -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Form -->
                        <RowDefinition Height="Auto" /> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientData}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Name}" Foreground="#333333" Margin="0,0,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                            <TextBox Text="{Binding CustomerNameInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" FontFamily="Cairo, Segoe UI" />

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                            <TextBox Text="{Binding CustomerPhoneInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" FontFamily="Cairo, Segoe UI" />

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Address}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                            <TextBox Text="{Binding CustomerAddressInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontSize="14" Height="40" Padding="10,10" VerticalContentAlignment="Center" Foreground="Black" FontFamily="Cairo, Segoe UI" />

                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNotes}" Foreground="#333333" Margin="0,12,0,8" FontSize="14" FontWeight="Bold" FontFamily="Cairo, Segoe UI" />
                            <TextBox Text="{Binding CustomerNotesInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="70" AcceptsReturn="True" TextWrapping="Wrap" 
                                     Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Top" FontSize="14" Padding="10,10" Foreground="Black" FontFamily="Cairo, Segoe UI" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Clear}" Width="60" Margin="5" Command="{Binding NewCustomerCommand}" Style="{StaticResource ModernButtonStyle}" />
                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SaveButton}" Width="60" Margin="5" Command="{Binding SaveCustomerCommand}" Style="{StaticResource ModernButtonStyle}" />
                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeleteButton}" Width="60" Margin="5" Command="{Binding DeleteCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF5252" BorderBrush="#FF5252" />
                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Report}" Width="60" Margin="5" Command="{Binding PrintReportCommand}" Style="{StaticResource ModernButtonStyle}" Background="#FF9800" BorderBrush="#FF9800" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- History Section (Middle) -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceMaintenanceHistory}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333" />
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WorkOrders}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15"
                              BorderThickness="1" BorderBrush="#EEEEEE"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DateField}" Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" Width="90" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceField}" Binding="{Binding DeviceType}" Width="100" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Model}" Binding="{Binding Model}" Width="80" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Cost}" Binding="{Binding TotalCost}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CalibrationCertificates}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333" />
                    
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Certificates}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="1" BorderBrush="#EEEEEE"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CertificateNumber}" Binding="{Binding CertificateNumber}" Width="100" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceField}" Binding="{Binding DeviceType}" Width="100" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Issue}" Binding="{Binding IssueDate, StringFormat=yyyy-MM-dd}" Width="90" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Expiry}" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Table Section (Right/End) -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,10,0" 
                                 Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientsSearchSmartTooltip}" />
                        
                        <Button Grid.Column="1" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Search}" Command="{Binding RefreshCustomersCommand}" Style="{StaticResource ModernButtonStyle}" Width="60" Margin="0,0,5,0" />
                        <Button Grid.Column="2" Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=Refresh}" Command="{Binding RefreshCustomersCommand}" Style="{StaticResource ModernButtonStyle}" Width="60" Background="#4CAF50" BorderBrush="#4CAF50" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RefreshCustomersListTooltip}" />
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              BorderThickness="1"
                              BorderBrush="#EEEEEE">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="⚠️" Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="🚨" Visibility="{Binding HasCalibrationAlert, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" ToolTip="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CalibrationAlertTooltip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=CompanyClientName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PhoneNumber}" Binding="{Binding Phone}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
