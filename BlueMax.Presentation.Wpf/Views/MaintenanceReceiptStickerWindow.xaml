<Window x:Class="BlueMax.Presentation.Wpf.Views.MaintenanceReceiptStickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
        Title="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceSticker}"
        Width="980"
        Height="680"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="White">
    <Window.Resources>
        <Style x:Key="DocumentViewerStyle" TargetType="DocumentViewer">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937" CornerRadius="10" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceStickerSettings}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=MaintenanceStickerData}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ClientNamePreview}" Foreground="#D1D5DB" FontSize="13" />
                    <TextBox Text="{Binding StickerCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,2,0,8" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceTypePreview}" Foreground="#D1D5DB" FontSize="13" />
                    <TextBox Text="{Binding StickerDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,2,0,8" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ModelPreview}" Foreground="#D1D5DB" FontSize="13" />
                    <TextBox Text="{Binding StickerModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,2,0,8" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DeviceSerial}" Foreground="#D1D5DB" FontSize="13" />
                    <TextBox Text="{Binding StickerSerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,2,0,8" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ReceivedDatePreview}" Foreground="#D1D5DB" FontSize="13" />
                    <DatePicker SelectedDate="{Binding StickerReceivedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RealDimensions}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerWidthMm}" Foreground="#D1D5DB" FontSize="13" />
                            <TextBox Text="{Binding StickerWidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" MinHeight="30" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerHeightMm}" Foreground="#D1D5DB" FontSize="13" />
                            <TextBox Text="{Binding StickerHeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" MinHeight="30" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=DefaultSize}" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerPrinter}" Foreground="White" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding InstalledPrinters}"
                              SelectedItem="{Binding SelectedPrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              MinHeight="30"
                              Margin="0,0,0,8" />

                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=SelectPrinterButton}"
                            Command="{Binding ChoosePrinterCommand}"
                            Margin="0,0,0,12"
                            Height="32" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ScaleContent}" Foreground="White" Margin="0,0,0,4" />
                    <Slider Minimum="0.8" Maximum="1.3" TickFrequency="0.01" IsSnapToTickEnabled="True"
                            Value="{Binding ContentScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding ContentScale, StringFormat=F2}" Foreground="#D1D5DB" Margin="0,2,0,12" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=HorizontalOffsetSticker}" Foreground="White" Margin="0,0,0,4" />
                    <Slider Minimum="-30" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ContentOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding ContentOffsetX, StringFormat=F0}" Foreground="#D1D5DB" Margin="0,2,0,12" />

                    <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=VerticalOffsetValue}" Foreground="White" Margin="0,0,0,4" />
                    <Slider Minimum="-30" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ContentOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding ContentOffsetY, StringFormat=F0}" Foreground="#D1D5DB" Margin="0,2,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RealPreview}" Command="{Binding RefreshPreviewCommand}" Width="130" Height="32" Margin="0,0,8,0" />
                        <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintStickerButton}" Command="{Binding PrintCommand}" Width="130" Height="32" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="8" Background="White">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=RefreshPreview}"
                            Command="{Binding RefreshPreviewCommand}"
                            Height="32" Margin="0,0,8,0" />
                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=PrintStickerButton}"
                            Command="{Binding PrintCommand}"
                            Height="32" Margin="0,0,16,0" />

                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ZoomIn}" Width="40" Height="32"
                            Command="{x:Static NavigationCommands.IncreaseZoom}"
                            CommandTarget="{Binding ElementName=StickerDocumentViewer}" Margin="0,0,6,0" />
                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=ZoomOut}" Width="40" Height="32"
                            Command="{x:Static NavigationCommands.DecreaseZoom}"
                            CommandTarget="{Binding ElementName=StickerDocumentViewer}" Margin="0,0,6,0" />
                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=FitWidth}" Height="32"
                            Command="{x:Static DocumentViewer.FitToWidthCommand}"
                            CommandTarget="{Binding ElementName=StickerDocumentViewer}" Margin="0,0,6,0" />
                    <Button Content="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=FitPage}" Height="32"
                            Command="{x:Static DocumentViewer.FitToMaxPagesAcrossCommand}"
                            CommandTarget="{Binding ElementName=StickerDocumentViewer}" />
                </StackPanel>

                <DocumentViewer x:Name="StickerDocumentViewer"
                                Document="{Binding PreviewDocument}"
                                Style="{StaticResource DocumentViewerStyle}"
                                Loaded="DocumentViewer_OnLoaded" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
