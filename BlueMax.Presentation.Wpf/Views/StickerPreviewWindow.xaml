<Window x:Class="BlueMax.Presentation.Wpf.Views.StickerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlueMax.Presentation.Wpf.Views"
        xmlns:converters="clr-namespace:BlueMax.Presentation.Wpf.Converters"
        xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
        Title="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerPreviewWindow}"
        Width="700"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceWindowBrush}"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <converters:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter"/>
        <converters:BooleanToFontStyleConverter x:Key="BooleanToFontStyleConverter"/>
        <converters:BooleanToTextDecorationsConverter x:Key="BooleanToTextDecorationsConverter"/>
        <converters:QrCodeConverter x:Key="QrCodeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="QrTemplate">
            <Image Source="{Binding DisplayText, Converter={StaticResource QrCodeConverter}, IsAsync=True}" 
                   Stretch="Uniform" 
                   Margin="2"
                   SnapsToDevicePixels="True"
                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <TextBlock Text="{Binding DisplayText}" 
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       Foreground="{Binding FontColor, Converter={StaticResource StringToBrushConverter}}"
                       TextAlignment="{Binding TextAlignment}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       FontWeight="{Binding IsBold, Converter={StaticResource BooleanToFontWeightConverter}}"
                       FontStyle="{Binding IsItalic, Converter={StaticResource BooleanToFontStyleConverter}}"
                       TextDecorations="{Binding IsUnderline, Converter={StaticResource BooleanToTextDecorationsConverter}}"
                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <DataTemplate x:Key="LogoTemplate">
            <Image Source="{Binding DisplayText, Converter={StaticResource ImagePathToBitmapConverter}, IsAsync=True}" 
                   Stretch="Uniform"
                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <DataTemplate x:Key="LineTemplate">
            <Rectangle Height="{Binding Height}" 
                       Width="{Binding Width}"
                       Fill="{Binding FontColor, Converter={StaticResource StringToBrushConverter}}"
                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </DataTemplate>

        <views:StickerItemTemplateSelector x:Key="StickerTemplateSelector"
                                           LogoTemplate="{StaticResource LogoTemplate}"
                                           QrTemplate="{StaticResource QrTemplate}"
                                           LineTemplate="{StaticResource LineTemplate}"
                                           TextTemplate="{StaticResource TextTemplate}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceCardBrush}" Padding="14" CornerRadius="8,8,0,0" Margin="10,10,10,0">
            <TextBlock Text="{Binding Source={x:Static viewmodels:TranslationViewModel.Instance}, Path=StickerPreviewWindow}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextNavyBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="10" Background="{DynamicResource SurfaceDividerBrush}" CornerRadius="0,0,8,8" Padding="20">
            <Viewbox Stretch="Uniform">
                <!-- Outer container to isolate FlowDirection -->
                <Border Background="White" 
                        BorderBrush="Black" 
                        BorderThickness="1"
                        Width="{Binding CanvasWidthPx}"
                        Height="{Binding CanvasHeightPx}"
                        FlowDirection="LeftToRight">
                    
                    <Grid x:Name="PreviewSurface">
                        <ItemsControl ItemsSource="{Binding StickerItems}">
                            <ItemsControl.Resources>
                                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="White" ClipToBounds="False"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Width" Value="{Binding Width}"/>
                                    <Setter Property="Height" Value="{Binding Height}"/>
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"
                                                     ContentTemplateSelector="{StaticResource StickerTemplateSelector}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Viewbox>
        </Border>
    </Grid>
</Window>
