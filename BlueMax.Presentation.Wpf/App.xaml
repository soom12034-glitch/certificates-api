<Application x:Class="BlueMax.Presentation.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BlueMax.Presentation.Wpf"
             xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
             xmlns:converters="clr-namespace:BlueMax.Presentation.Wpf.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Static x:Key="TranslationViewModel" Member="viewmodels:TranslationViewModel.Instance" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:EmptyStateVisibilityConverter x:Key="EmptyStateVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
