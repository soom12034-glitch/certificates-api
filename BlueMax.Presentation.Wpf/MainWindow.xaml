<Window x:Class="BlueMax.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlueMax.Presentation.Wpf"
        xmlns:viewmodels="clr-namespace:BlueMax.Presentation.Wpf.ViewModels"
        xmlns:views="clr-namespace:BlueMax.Presentation.Wpf.Views"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource SurfaceBackground}"
        FontFamily="Cairo"
        mc:Ignorable="d"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Title="{Binding Source={StaticResource TranslationViewModel}, Path=Certificates}"
        FlowDirection="RightToLeft"
        >
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+," Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ShowHomeCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CertificatesViewModel}">
            <views:CertificatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClientsViewModel}">
            <views:ClientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MaintenanceViewModel}">
            <views:MaintenanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DeviceHistoryViewModel}">
            <views:DeviceHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StickerDesignerViewModel}">
            <views:StickerDesignerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReceiptStickerDesignerViewModel}">
            <views:StickerDesignerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RentalsViewModel}">
            <views:RentalsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
            <views:HomeView />
        </DataTemplate>
    </Window.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0" x:Name="SidebarColumn"/>
        </Grid.ColumnDefinitions>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الشريط العلوي (TopNavbar) -->
            <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- زر القائمة -->
                    <Button Grid.Column="0" Style="{StaticResource TopBarButtonStyle}" Click="OnToggleSidebarClick" Margin="0,0,12,0">
                        <Border Width="32" Height="32" CornerRadius="8" Background="White">
                            <TextBlock Text="☰" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <!-- عنوان الشاشة -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>

                    <!-- الأزرار -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TopBarButtonStyle}" Click="OnHelpClick">
                            <TextBlock Text="?" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Margin="8,0" Click="OnNotificationsClick">
                            <Grid>
                                <Border Width="32" Height="32" CornerRadius="8" Background="White">
                                    <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="NotificationBadge"
                                        Background="{DynamicResource DangerBrush}"
                                        CornerRadius="8"
                                        Width="16" Height="16"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-4,-4,0">
                                    <TextBlock x:Name="NotificationBadgeText" Text="0" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Margin="8,0" Click="OnToggleThemeClick">
                            <Border Width="32" Height="32" CornerRadius="8" Background="White">
                                <TextBlock Text="🌙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Margin="8,0" Click="OnLanguageClick">
                            <Border Width="32" Height="32" CornerRadius="8" Background="White">
                                <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource TopBarButtonStyle}" Margin="8,0" Click="OnNavLoginClick">
                            <Border Width="32" Height="32" CornerRadius="8" Background="White">
                                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- المحتوى -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" Margin="16" CornerRadius="12">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>

        <!-- الشريط الجانبي (Sidebar) على اليمين - مخفي افتراضياً -->
        <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" FlowDirection="RightToLeft" x:Name="SidebarBorder" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Black}" BlurRadius="30" ShadowDepth="8" Opacity="0.4"/>
            </Border.Effect>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شعار المنشأة -->
                <Border Grid.Row="0" Background="Transparent" Padding="24" Margin="0,24,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" Background="{DynamicResource PurpleGradient}" CornerRadius="16" Margin="0,0,0,12">
                            <TextBlock Text="C" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Certificates}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=SystemOverview}" Foreground="{DynamicResource TextSidebarBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- فاصل -->
                <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderSidebarBrush}" Margin="16,0,16,16" VerticalAlignment="Bottom"/>

                <!-- القائمة الرئيسية -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0">
                        <Button Click="OnNavHomeClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Home}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavCertificatesClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Certificates}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryVioletBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavMaintenanceClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Maintenance}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SecondaryPinkBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavClientsClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Clients}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavInventoryClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Inventory}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavDeviceHistoryClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📜" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=DeviceHistory}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource InfoCyanBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavRentalsClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Rentals}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource InfoBlueBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavStickerClick" IsEnabled="{Binding CanAccessStickerDesigner}" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=StickerDesigner}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavReceiptStickerClick" IsEnabled="{Binding CanAccessReceiptStickerDesigner}" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=ReceiptStickerDesigner}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnNavSettingsClick" Background="Transparent" BorderThickness="0" Padding="16,14" Margin="0,2" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="22" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding Source={StaticResource TranslationViewModel}, Path=Settings}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TextHintBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
