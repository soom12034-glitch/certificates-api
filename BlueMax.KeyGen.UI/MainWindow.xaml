<Window x:Class="BlueMax.KeyGen.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueMax Key Generator" Height="450" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="مولد مفاتيح التفعيل" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#333"/>

        <!-- Input Section -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="بصمة الجهاز (Hardware ID):" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtHardwareId" Height="35" FontSize="14" Padding="5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="لصق" Width="60" Margin="5,0,0,0" Click="BtnPaste_Click"/>
            </Grid>

            <TextBlock Text="تاريخ الانتهاء:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <DatePicker x:Name="DpExpiration" Height="35" FontSize="14" Margin="0,0,0,20" SelectedDate="{x:Static sys:DateTime.Today}"
                        xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
            
            <Button x:Name="BtnGenerate" Content="توليد المفتاح" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#007ACC" Foreground="White" Click="BtnGenerate_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Output Section -->
        <StackPanel Grid.Row="2" Margin="0,30,0,0">
            <TextBlock Text="مفتاح التفعيل (License Key):" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLicenseKey" Height="80" FontSize="12" Padding="5" 
                         TextWrapping="Wrap" IsReadOnly="True" Background="#EEE"/>
                <Button Grid.Column="1" Content="نسخ" Width="60" Margin="5,0,0,0" Height="80" Click="BtnCopy_Click"/>
            </Grid>
        </StackPanel>
        
        <!-- Status -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus" Foreground="Green" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>